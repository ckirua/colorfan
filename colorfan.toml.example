# Copy to ./colorfan.toml or ~/.config/colorfan/colorfan.toml

# Path to the openrgb binary (or set OPENRGB_PATH)
openrgb_path = "openrgb"

# Device index from `openrgb --list-devices` (often 0 for the primary Aura controller)
device = 0

# auto | always | never  (or env OPENRGB_USE_SUDO=0|1|auto)
use_sudo = "auto"

# Avoid hanging on OpenRGB SDK autoconnect
no_autoconnect = true

# Aura works best with Direct; Static is also fine (or OPENRGB_MODE)
mode = "direct"

# Prefer OpenRGB SDK server for fast applies (or COLORFAN_SDK=0 to force CLI)
prefer_sdk = true

# Last-known solid colors per zone index (RRGGBB). Updated automatically on apply
# so a single-zone change can re-apply siblings without blanking them.
# Typical Aura layout: 0 = Mainboard, 1–3 = Addressable headers.
[zone_colors]
0 = "000000"
1 = "0000FF"
2 = "00FF00"
3 = "FF0000"
